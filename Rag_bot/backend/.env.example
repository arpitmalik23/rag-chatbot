# Copy to .env (or export as real env vars) before running the backend.
# Spring reads these via ${VAR_NAME} placeholders in application.properties.

GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIMENSIONS=768

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=doc_chunks

# Upstash Redis connection string, e.g.:
# rediss://default:AbCdEf123@your-db.upstash.io:6379
UPSTASH_REDIS_URL=rediss://default:password@your-db.upstash.io:6379

CORS_ALLOWED_ORIGINS=http://localhost:5173
RAG_TOP_K=4
